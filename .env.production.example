# =====================================================================
# Contoh .env untuk PRODUKSI (Hostinger). Salin jadi `.env` DI SERVER,
# lalu isi nilai asli. JANGAN commit file .env asli ke git.
# =====================================================================

APP_NAME="Pondok Tince"
APP_ENV=production
APP_KEY=                      # jalankan: php artisan key:generate
APP_DEBUG=false
APP_URL=https://pondoktince.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=Asia/Jakarta

# --- Database: pakai MySQL Hostinger (buat di hPanel > Databases) ---
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=u598194357_pondoktince      # ganti sesuai nama DB di hPanel
DB_USERNAME=u598194357_admin            # ganti sesuai user DB di hPanel
DB_PASSWORD=                            # password DB dari hPanel

# --- Session & cache: aman pakai database di shared hosting ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database

FILESYSTEM_DISK=public

# --- Mail (opsional; isi jika mau kirim email) ---
MAIL_MAILER=log
MAIL_FROM_ADDRESS="halo@pondoktince.com"
MAIL_FROM_NAME="${APP_NAME}"

LOG_CHANNEL=stack
LOG_LEVEL=error
